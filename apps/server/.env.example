PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://user:password@localhost:5432/mail_app
ENCRYPTION_MASTER_KEY=replace-with-32-byte-base64-key
PUSH_PROVIDER=noop
# macOS/iOS push: PUSH_PROVIDER=apns with an APNs auth key (.p8) kept outside the repo.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.dailypostbox.app
APNS_PRODUCTION=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
OAUTH_REDIRECT_BASE_URL=https://api.dailypostbox.com
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OUTLOOK_OAUTH_CLIENT_ID=
OUTLOOK_OAUTH_CLIENT_SECRET=
